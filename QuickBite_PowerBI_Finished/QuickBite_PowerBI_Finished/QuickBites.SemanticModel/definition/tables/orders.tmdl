table orders
	lineageTag: b182cb1c-43c1-4897-868d-5975824281a9

	/// Every order placed, including cancelled.
	measure Orders = COUNTROWS(orders)
		formatString: #,0
		displayFolder: Crisis
		lineageTag: 1ab3d57a-e1b5-4b6c-afba-3283bb390079

	/// Average monthly order count across the months in context. Months with no orders are skipped.
	measure 'Orders per Month' = AVERAGEX(VALUES('Date'[Month Start]), [Orders])
		formatString: #,0
		displayFolder: Crisis
		lineageTag: 41d11bf7-b5ef-413b-804d-974aebadfc7d

	/// Sum of total_amount on non-cancelled orders.
	measure Revenue = CALCULATE(SUM(orders[total_amount]), orders[is_cancelled] = FALSE())
		formatString: #,0
		displayFolder: Crisis
		lineageTag: 9bc0064d-4468-4fda-97c8-ccf4de9a4f60

	/// Average monthly revenue (non-cancelled) across the months in context.
	measure 'Revenue per Month' = AVERAGEX(VALUES('Date'[Month Start]), [Revenue])
		formatString: #,0
		displayFolder: Crisis
		lineageTag: bd73e8fc-6cf6-427d-be95-5da32294b51b

	/// Cancelled orders / all orders.
	measure 'Cancellation Rate' = DIVIDE(CALCULATE([Orders], orders[is_cancelled] = TRUE()), [Orders])
		formatString: 0.0%
		displayFolder: Crisis
		lineageTag: d7a06ef3-69d5-4a44-92d4-7311cb61b4d8

	/// Average actual delivery minutes on non-cancelled orders.
	measure 'Avg Delivery Time (mins)' = CALCULATE(AVERAGE(delivery[actual_delivery_time_mins]), orders[is_cancelled] = FALSE())
		formatString: 0.0
		displayFolder: Crisis
		lineageTag: c103af9b-2ba5-4f09-9bc5-8110c0d277ba

	/// Average rating, attributed to the month the order was placed.
	measure 'Avg Rating' = AVERAGE(ratings[rating])
		formatString: 0.00
		displayFolder: Crisis
		lineageTag: ce587561-156e-450c-8e92-6f4552e7682e

