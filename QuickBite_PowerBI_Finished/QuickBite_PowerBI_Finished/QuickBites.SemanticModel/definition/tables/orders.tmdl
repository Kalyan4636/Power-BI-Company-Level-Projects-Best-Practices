	column order_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3cd885ed-4c1d-404e-8059-95e6e8467ebe
		summarizeBy: none
		sourceColumn: order_date

	partition orders = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("D:\temp-woking-folder\dryrun\powerbi\QuickBite_Orders_Messy.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "orders", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  // Some timestamps arrive as day-first text (dd/MM/yyyy HH:mm), the rest as real datetimes
				  #"Fixed order_timestamp" = Table.TransformColumns(#"Promoted headers", {{"order_timestamp", each if _ is text then DateTime.FromText(_, [Format = "dd/MM/yyyy HH:mm", Culture = "en-GB"]) else _, type datetime}}),
				  // Some totals arrive as text with a currency tag: "Rs 358.98", "₹240.27", "322.75 INR"
				  #"Fixed total_amount" = Table.TransformColumns(#"Fixed order_timestamp", {{"total_amount", each if _ is text then Number.From(Text.Select(_, {"0".."9", ".", "-"}), "en-US") else _, type number}}),
				  // Flags mix Y/N, yes/no, Yes, TRUE/FALSE. Unknown spellings raise an error so they surface on refresh instead of becoming false
				  ToFlag = (v) => let t = Text.Lower(Text.Trim(Text.From(v))) in if v = null then null else if List.Contains({"y", "yes", "true"}, t) then true else if List.Contains({"n", "no", "false"}, t) then false else error "Unknown flag value: " & t,
				  #"Fixed flags" = Table.TransformColumns(#"Fixed total_amount", {{"is_cod", ToFlag, type logical}, {"is_cancelled", ToFlag, type logical}}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Fixed flags", {{"order_id", type text}, {"customer_id", type text}, {"restaurant_id", type text}, {"delivery_partner_id", type text}, {"subtotal_amount", type number}, {"discount_amount", type number}, {"delivery_fee", type number}}, "en-US"),
				  // The export repeats some orders; keep one row per order_id
				  #"Removed duplicates" = Table.Distinct(#"Changed column type", {"order_id"}),
				  // Date-only key for the Date table relationship
				  #"Added order_date" = Table.AddColumn(#"Removed duplicates", "order_date", each DateTime.Date([order_timestamp]), type date)
				in
				  #"Added order_date"

	annotation PBI_ResultType = Table

