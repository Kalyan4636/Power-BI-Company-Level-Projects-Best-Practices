	partition ratings = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("D:\temp-woking-folder\dryrun\powerbi\QuickBite_Orders_Messy.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "ratings", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  // The sheet has fully empty rows; a rating with no order is unusable
				  #"Removed blank rows" = Table.SelectRows(#"Promoted headers", each [order_id] <> null),
				  // review_timestamp arrives as day-first text (dd-MM-yyyy HH:mm); en-US parsing swapped day/month or errored
				  #"Fixed review_timestamp" = Table.TransformColumns(#"Removed blank rows", {{"review_timestamp", each if _ is text then DateTime.FromText(_, [Format = "dd-MM-yyyy HH:mm", Culture = "en-GB"]) else _, type datetime}}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Fixed review_timestamp", {{"order_id", type text}, {"customer_id", type text}, {"restaurant_id", type text}, {"rating", type number}, {"review_text", type text}, {"sentiment_score", type number}}, "en-US")
				in
				  #"Changed column type"

